# ─────────────────────────────────────────────────────────────────────────────
# Echo — environment
#
# Copy to `.env` and fill in. Every value is OPTIONAL: with an empty .env the
# app runs fully offline (local-first), recording and transcribing on-device.
# Each block below unlocks one additional capability.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase: cloud sync, cross-device notes, audio backup ──────────────────
# Project Settings → API. The publishable/anon key is safe to ship in a client.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Google: Calendar + Gmail ────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs.
# Create one client per platform. Redirect URI for the Expo proxy / dev client:
#   echo://redirect
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Server-side only — set these with `supabase secrets set`, NEVER in this file
# once it becomes a real .env that ships in a build.
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set OPENAI_API_KEY=sk-...          # optional STT fallback
#
# ANTHROPIC_API_KEY — powers note enrichment (title, summary, action items,
#   calendar/email suggestions) in the `enrich-note` edge function.
# OPENAI_API_KEY    — optional Whisper fallback in `transcribe-audio`, used only
#   when on-device recognition produced nothing (very noisy audio, unsupported
#   locale, or recognition interrupted).
# ─────────────────────────────────────────────────────────────────────────────
